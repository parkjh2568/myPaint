{
    "name": "mypaint-web",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "check": "tsc --noEmit",
        "build": "npm run check && vite build",
        "test": "tsx --test tests/*.test.ts",
        "desktop": "node tools/desktop.mjs dev",
        "desktop:build": "node tools/desktop.mjs build",
        "test:browser": "node --import tsx tests/browser.mjs && node --import tsx tests/concurrency.mjs && node --import tsx tests/editing.mjs && node --import tsx tests/storage.mjs && node --import tsx tests/shear.mjs",
        "format": "prettier --write src tests tools *.json *.ts index.html",
        "format:check": "prettier --check src tests tools *.json *.ts index.html",
        "test:performance": "node --import tsx tests/performance.mjs",
        "test:native-profile": "node --import tsx tests/native-profile.mjs",
        "test:tiles": "node --import tsx tests/tiles.mjs",
        "test:native-persistence": "node --import tsx tests/native-persistence.mjs",
        "test:native-desktop": "node --import tsx tests/native-desktop.mjs",
        "test:bulk-edit": "node --import tsx tests/bulk-edit.mjs",
        "test:max-document": "node --expose-gc --import tsx tests/max-document.mjs",
        "test:pointer-contract": "node --import tsx tests/pointer-contract.mjs",
        "test:color-eraser-contract": "node --import tsx tests/color-eraser-contract.mjs",
        "test:shape-color-contract": "node --import tsx tests/shape-color-contract.mjs",
        "test:pending-contract": "node --import tsx tests/pending-contract.mjs",
        "test:clipboard-contract": "node --import tsx tests/clipboard-contract.mjs",
        "test:scene-contract": "node tools/scene-contract.mjs",
        "test:gif-input": "node --import tsx tests/gif-input.mjs",
        "test:eraser-picker-contract": "node --import tsx tests/eraser-picker-contract.mjs",
        "test:square-contract": "node --import tsx tests/square-contract.mjs",
        "test:render-preparation": "node --import tsx tests/render-preparation.mjs",
        "test:alpha-contract": "node --import tsx tests/selection-alpha-contract.mjs && node --import tsx tests/text-alpha-contract.mjs",
        "test:selection-contract": "node --import tsx tests/selection-mask-contract.mjs && node --import tsx tests/selection-crop-contract.mjs && node --import tsx tests/selection-mask-failure.mjs",
        "test:selection-source": "node --import tsx tests/selection-source-contract.mjs && node --import tsx tests/paste-transform-contract.mjs",
        "test:fill-failure": "node --import tsx tests/fill-failure-contract.mjs",
        "test:fill-key": "node --import tsx tests/fill-key-contract.mjs",
        "test:cut-key": "node --import tsx tests/cut-key-contract.mjs",
        "test:masked-transform": "node --import tsx tests/masked-transform-contract.mjs",
        "test:selection-preparation": "node --import tsx tests/selection-preparation-contract.mjs",
        "test:selection-resize": "node --import tsx tests/selection-resize-contract.mjs",
        "test:jpeg-orientation": "node --import tsx tests/jpeg-orientation.mjs",
        "test:roundrect-contract": "node --import tsx tests/roundrect-contract.mjs",
        "test:export-preview": "node --import tsx tests/export-preview-contract.mjs",
        "test:touch-viewport": "node --import tsx tests/touch-viewport-contract.mjs",
        "test:camera-viewport": "node --import tsx tests/camera-viewport-contract.mjs",
        "test:recovery-contract": "node --import tsx tests/recovery-contract.mjs",
        "test:codec-reply": "node --import tsx tests/codec-reply-contract.mjs",
        "test:native-recovery-flow": "node --import tsx tests/native-recovery-flow.mjs",
        "test:spray-contract": "node --import tsx tests/spray-contract.mjs",
        "test:fixture-inventory": "tsx --test tests/fixture-inventory.test.ts",
        "test:matched-core": "node --import tsx tests/matched-core.mjs",
        "test:core-fixtures": "node tests/core-fixtures.mjs",
        "test:usability": "node --import tsx tests/usability.mjs",
        "test:eraser-settings": "node --import tsx tests/eraser-settings.mjs",
        "test:document-tabs": "node --import tsx tests/document-tabs.mjs"
    },
    "dependencies": {
        "buffer": "6.0.3",
        "fflate": "0.8.3",
        "jpeg-js": "0.4.4",
        "pako": "3.0.3"
    },
    "devDependencies": {
        "@tauri-apps/cli": "2.12.4",
        "@types/node": "24.10.0",
        "playwright": "1.62.1",
        "prettier": "3.6.2",
        "tsx": "4.21.0",
        "typescript": "6.0.2",
        "vite": "8.3.5"
    },
    "overrides": {
        "esbuild": "0.28.1"
    }
}
