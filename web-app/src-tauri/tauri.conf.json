{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myPaint Studio",
  "version": "0.2.0",
  "identifier": "io.github.parkjh2568.mypaint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8922",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "myPaint Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Offline drawing studio",
    "category": "GraphicsAndDesign",
    "copyright": "myPaint contributors",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
