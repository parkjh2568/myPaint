  "changes": [
    {
      "priority": "Major / P1",
      "cost": "S",
      "issue": "GIF logical-screen validation missed a larger or offset first image descriptor before native decoding.",
      "implementation": "Inline bounded GIF header/global-palette/extension traversal stops at the first image descriptor and validates max(logical width,left+width) × max(logical height,top+height). Existing bitmap postcheck and close/release remain.",
      "compatibility": "Bounded out-of-screen first frames still reach the platform decoder; their returned pixels/dimensions are not rewritten. Animation retains the first-frame policy; later frames are not newly banned or scanned."
    },
    {
      "priority": "Major / P1",
      "cost": "S",
      "issue": "The new synchronous prefix scan delayed cancellation on millions of empty extension blocks.",
      "implementation": "At each256KiB progress checkpoint, compare elapsed time to a4ms soft budget. Yield a timer task only when needed, then recheck cancellation; check cancellation again before Blob/bitmap. No helper extraction or new dependency.",
      "tradeoff": "Better cancellation responsiveness increases total completion time on extreme empty-extension prefixes. Fast payload-block inputs produced no unnecessary yields in the recorded experiment."
    }
  ],
