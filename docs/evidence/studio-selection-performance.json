    },
    {
      "severity": "Major performance risk",
      "cost": "M",
      "name": "Dense even-odd mask rows repeatedly sort active intersections",
      "evidence": "Repeated frozen Node1Mi mask kernel dense2048 baseline110.064ms. Paired protocol before98.997→final23.775ms; not a measured physical lasso-up latency.",
      "fix": "Inside polygonMask, rows with even active count>=64 and>=width/2 XOR identical floored/clamped column endpoints in a lazy width+1 byte bucket, then fill half-open runs. Sparse/odd rows keep original sort/pair path.",
      "contracts": "Preclip,26.6/16.16 quantization, edge activation/advance/retire, original points and complete mask remain identical. No point decimation or viewport splitting."
    }
